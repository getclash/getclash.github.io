---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pages } from '../lib/content.mjs';

export function getStaticPaths() {
  return pages
    .filter(page => page.route !== '/' && page.route !== '/404.html' && page.route !== '/faq/')
    .map(page => ({
      params: { slug: page.route.replace(/^\/|\/$/g, '') },
      props: { page },
    }));
}

const { page } = Astro.props;
---
<BaseLayout page={page}><Fragment set:html={page.body} /></BaseLayout>
