---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { faq, faqPage } from '../lib/faq.mjs';
const quickQuestions = ['subscription-failed', 'connection-timeout', 'proxy-not-working', 'tun-disconnected'];
---
<BaseLayout page={faqPage}>
  <div class="wrap faq-header">
    <nav class="breadcrumbs" aria-label="面包屑"><a href="/">首页</a><span aria-hidden="true">/</span><span aria-current="page">常见问题</span></nav>
    <div class="faq-header-grid"><div><span class="eyebrow">TROUBLESHOOTING / 常见问题</span><h1>Clash 常见问题<br /><span>与故障排查</span></h1><p>订阅导不进、节点连不上，还是开启 TUN 后断网？<br class="desktop-only" />按问题类型查找原因和处理步骤。</p></div><div class="faq-header-note"><Icon name="search" /><strong>先从出错的环节查起</strong><p>确认配置 → 观察请求 → 检查规则与出口。<br />记录每一步的结果，方便对照和反馈。</p><span>{faq.questions.length} 个问题 · {faq.categories.length} 个分类 · 更新于 <time datetime={faq.updated}>{faq.updated}</time></span></div></div>
    <div class="faq-quick"><span>常用排查</span>{quickQuestions.map(id => { return <a href={`#${id}`}>{({ 'subscription-failed': '订阅导入失败', 'connection-timeout': '节点超时', 'proxy-not-working': '系统代理不生效', 'tun-disconnected': 'TUN 开启后断网' })[id]} <Icon name="arrow" /></a>; })}</div>
  </div>
  <div class="wrap faq-layout" data-faq-hub>
    <aside class="faq-navigation" aria-label="常见问题分类"><strong>按问题类型查找</strong>{faq.categories.map((category, index) => <a href={`#${category.id}`}><span>0{index + 1}</span>{category.title}<Icon name="right" /></a>)}<a class="faq-all-guides" href="/guides/">需要完整步骤？查看教程 <Icon name="book" /></a></aside>
    <div class="faq-content">
      <div class="faq-search"><label for="faq-search"><Icon name="search" /><span class="sr-only">搜索常见问题</span><input id="faq-search" type="search" placeholder="搜索问题、错误提示，如 timeout、订阅…" autocomplete="off" data-faq-search /></label><p aria-live="polite" data-faq-count>共 {faq.questions.length} 个问题，答案可直接展开阅读</p></div>
      <div class="faq-empty" hidden data-faq-empty><h2>没有找到匹配的问题</h2><p>试试“端口”“DNS”或“配置”，也可以清空关键词浏览全部。</p><button class="button secondary" type="button" data-faq-reset>查看全部问题</button></div>
      {faq.categories.map((category, index) => <section class="faq-category" id={category.id} data-faq-category><div class="faq-category-heading"><span class="faq-category-icon"><Icon name={category.icon} /></span><div><span class="eyebrow">0{index + 1}</span><h2>{category.title}</h2><p>{category.description}</p></div></div><div class="faq-list">{faq.questions.filter(question => question.category === category.id).map(question => <details id={question.id} data-faq-item data-faq-text={[question.question, question.answer, ...question.steps].join(' ')}><summary><h3>{question.question}</h3><span aria-hidden="true">+</span></summary><div class="faq-answer"><p>{question.answer}</p><ol>{question.steps.map(step => <li>{step}</li>)}</ol><div class="faq-next-links">{question.links.map(link => <a href={link.url} {...(link.url.startsWith('https:') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{link.label}<Icon name="arrow" /></a>)}</div><a class="faq-permalink" href={`#${question.id}`} aria-label={`问题固定链接：${question.question}`}>此问题的固定链接 #</a></div></details>)}</div></section>)}
      <section class="faq-references" aria-labelledby="faq-references-title"><h2 id="faq-references-title">答案的依据与适用范围</h2><p>本站为独立资料站。排查步骤以 Mihomo 文档及本站平台教程为依据，具体按钮、权限和配置字段以所用客户端与内核版本为准。</p><ul><li><a href="https://wiki.metacubex.one/config/general/" target="_blank" rel="noopener noreferrer">Mihomo 全局配置：模式、日志与控制接口 ↗</a></li><li><a href="https://wiki.metacubex.one/config/proxy-providers/" target="_blank" rel="noopener noreferrer">Mihomo 代理集合：更新与节点来源 ↗</a></li><li><a href="https://wiki.metacubex.one/config/dns/" target="_blank" rel="noopener noreferrer">Mihomo DNS 配置与解析模式 ↗</a></li><li><a href="https://wiki.metacubex.one/config/inbound/tun/" target="_blank" rel="noopener noreferrer">Mihomo TUN：自动路由与 DNS 处理 ↗</a></li></ul><p>仍未解决？整理版本、复现步骤和已脱敏的错误日志，前往对应软件的项目仓库反馈。<a href="/apps/">查找软件与项目来源 →</a></p></section>
    </div>
  </div>
</BaseLayout>
